<?xml version="1.0"?>
<info>
    <id>renamer</id>
    <name>Renamer</name>
    <summary>File renaming tools</summary>
    <description>
        Rename files safely using rules (regex, replace, metadata-ready).
        Supports import/export of rule sets, default presets, and dev mode bash output.
    </description>

    <version>0.2.0</version>
    <licence>AGPL</licence>
    <author>voualla</author>

    <namespace>Renamer</namespace>

    <dependencies>
        <nextcloud min-version="31" max-version="33"/>
    </dependencies>

    <capabilities>
        <fileactions />
        <files />
    </capabilities>

    <bootstrap-class>\OCA\Renamer\AppInfo\Application</bootstrap-class>
</info>
